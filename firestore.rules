rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Registrations collection for PMB STARS YKPN
    match /registrations/{registrationId} {
      // Public prospective students can submit registration
      // Admin and staff can read, verify, update, and manage records across all devices
      allow read, write: if true;
    }

    // Connection health check
    match /test/{docId} {
      allow read, write: if true;
    }

    // Default deny for anything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
